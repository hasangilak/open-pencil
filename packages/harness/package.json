{
  "name": "@open-pencil/harness",
  "version": "0.16.0",
  "private": false,
  "description": "Optional OpenPencil companion CLI for coding-agent Harness sessions, over stdio for the desktop app or WebSocket for the browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/harness"
  },
  "bin": {
    "openpencil-harness": "./dist/stdio.mjs",
    "openpencil-harness-serve": "./dist/serve.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./constants": {
      "types": "./dist/constants.d.mts",
      "bun": "./src/constants.ts",
      "import": "./dist/constants.mjs",
      "default": "./dist/constants.mjs"
    },
    "./pairing": {
      "types": "./dist/pairing.d.mts",
      "bun": "./src/pairing.ts",
      "import": "./dist/pairing.mjs",
      "default": "./dist/pairing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.138",
    "@ai-sdk/harness-pi": "1.0.140",
    "@ai-sdk/sandbox-just-bash": "1.0.138",
    "@earendil-works/pi-tui": "0.85.1",
    "@open-pencil/mcp": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/ws": "^8.18.1",
    "typescript": "~5.8.3"
  }
}
